import math


def run_task_a1_delays_and_bdp():
    print("=" * 72)
    print("TASK A1: END-TO-END DELAY BREAKDOWN & BANDWIDTH-DELAY PRODUCT (BDP)")
    print("=" * 72)
    pkt_bits = 1500 * 8
    dist_m = 2000 * 1000
    speed_mps = 2e8
    rate_100m = 100e6
    rate_1g = 1e9
    routers = 3

    d_prop_ms = (dist_m / speed_mps) * 1000
    d_trans_100m_ms = (pkt_bits / rate_100m) * 1000 * (routers + 1)
    d_trans_1g_ms = (pkt_bits / rate_1g) * 1000 * (routers + 1)
    d_queue_ms = routers * 0.5
    d_proc_ms = routers * 0.1

    total_100m = d_prop_ms + d_trans_100m_ms + d_queue_ms + d_proc_ms
    total_1g = d_prop_ms + d_trans_1g_ms + d_queue_ms + d_proc_ms

    print(f"Propagation delay (2,000 km)      : {d_prop_ms:.2f} ms (Dominant: {d_prop_ms/total_100m*100:.1f}%)")
    print(f"Transmission delay (4x 100 Mbps)  : {d_trans_100m_ms:.2f} ms")
    print(f"Queuing + Processing (3 routers)  : {d_queue_ms + d_proc_ms:.2f} ms")
    print(f"Total One-Way Delay (100 Mbps)    : {total_100m:.2f} ms -> Upgraded to 1 Gbps: {total_1g:.2f} ms")

    # A1.2 BDP on 1 Gbps, 80 ms RTT
    rtt_s = 0.080
    bdp_bytes = (rate_1g * rtt_s) / 8
    tcp_win_bits = 64 * 1024 * 8
    max_thr_mbps = (tcp_win_bits / rtt_s) / 1e6
    print(f"BDP (1 Gbps, 80 ms RTT)           : {bdp_bytes / 1e6:.2f} MB ({bdp_bytes / (1024**2):.2f} MiB)")
    print(f"Max Throughput with 64 KB Window  : {max_thr_mbps:.2f} Mbps\n")


def run_task_a3_p2p_and_voip():
    print("=" * 72)
    print("TASK A3: P2P DISTRIBUTION TIME & VoIP G.711 BANDWIDTH SIZING")
    print("=" * 72)
    file_bits = 4 * (1024 ** 3) * 8  # 4 GiB in bits
    n_centres = 20
    u_server = 100e6
    d_centre = 50e6
    u_centre = 20e6

    d_cs = max((n_centres * file_bits) / u_server, file_bits / d_centre)
    d_p2p = max(file_bits / u_server, file_bits / d_centre,
                (n_centres * file_bits) / (u_server + n_centres * u_centre))

    print(f"Client-Server 4 GB Distribution   : {d_cs:.2f} s ({d_cs / 60:.2f} mins)")
    print(f"Peer-to-Peer 4 GB Distribution    : {d_p2p:.2f} s ({d_p2p / 60:.2f} mins)")

    # VoIP G.711 (64 kbps, 20 ms packets, 40 B headers)
    pps = 1000 // 20
    payload_bytes = int((64000 * 0.020) // 8)
    total_pkt_bits = (payload_bytes + 40) * 8
    bw_per_dir_kbps = (pps * total_pkt_bits) / 1000
    calls_2mbps = int(2000 // bw_per_dir_kbps)
    print(f"G.711 VoIP: {pps} pkt/s, {bw_per_dir_kbps:.1f} kbps/direction -> "
          f"{calls_2mbps} one-way streams ({calls_2mbps // 2} full-duplex calls) on 2 Mbps\n")


def run_task_a4_firewall():
    print("=" * 72)
    print("TASK A4: STATELESS PACKET FILTER (CORRECTED VS. SWAPPED RULES)")
    print("=" * 72)

    RULES = [
        # (action, protocol, destination port or None for any, source prefix or None)
        ("allow", "tcp", 443, None),
        ("allow", "tcp", 22, "10.1."),
        ("deny", "tcp", 22, None),
        ("allow", "udp", 53, None),
    ]
    DEFAULT = "deny"

    def decide(rules, proto, port, src):
        for action, p, dport, prefix in rules:
            if p == proto and (dport is None or dport == port) and (prefix is None or src.startswith(prefix)):
                return action
        return DEFAULT

    packets = [("tcp", 443, "49.37.2.8"), ("tcp", 22, "10.1.4.20"),
               ("tcp", 22, "49.37.2.8"), ("udp", 53, "10.1.4.20"),
               ("tcp", 80, "49.37.2.8"), ("icmp", None, "49.37.2.8")]

    print("--- Correct Rule Order ---")
    for pk in packets:
        print(f"{pk[0]:<5} {str(pk[1]):<5} from {pk[2]:<10} -> {decide(RULES, *pk)}")

    # Swap 2nd and 3rd rules
    SWAPPED_RULES = [RULES[0], RULES[2], RULES[1], RULES[3]]
    print("\n--- After Swapping Rules 2 and 3 (Deny SSH Before Admin Allow) ---")
    for pk in packets:
        print(f"{pk[0]:<5} {str(pk[1]):<5} from {pk[2]:<10} -> {decide(SWAPPED_RULES, *pk)}")
    print()


