def run_q1_sockets():
    print("=" * 70)
    print("Q1: UDP AND TCP MULTIPLEXING / DEMULTIPLEXING SOCKETS")
    print("=" * 70)

    def udp_server(sock):
        for _ in range(3):
            data, addr = sock.recvfrom(1024)
            reply = b"ACK:" + data
            sock.sendto(reply, addr)

    def tcp_server(sock):
        conn, _ = sock.accept()
        with conn:
            total = 0
            while True:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                total += len(chunk)
            print(f"TCP server received {total} bytes in order")

    u = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    u.bind(("127.0.0.1", 0))
    t = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    t.bind(("127.0.0.1", 0))
    t.listen(1)

    th_u = threading.Thread(target=udp_server, args=(u,))
    th_t = threading.Thread(target=tcp_server, args=(t,))
    th_u.start()
    th_t.start()

    for name in ("lab1", "lab2", "lab3"):
        c = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        c.sendto(name.encode(), u.getsockname())
        reply, _ = c.recvfrom(1024)
        print("UDP", name, "->", reply.decode())
        c.close()

    c = socket.create_connection(t.getsockname())
    c.sendall(b"x" * 100_000)
    c.close()

    th_u.join()
    th_t.join()
    u.close()
    t.close()
    print()


def run_q2_congestion_control():
    print("=" * 70)
    print("Q2: TCP CONGESTION CONTROL (RENO VS. TAHOE OVER 20 RTTS)")
    print("=" * 70)

    def simulate(losses, ssthresh=16, reno=True):
        cwnd, trace = 1, []
        for rtt in range(1, 21):
            trace.append(cwnd)
            if rtt in losses:
                ssthresh = max(cwnd // 2, 2)
                cwnd = ssthresh if reno else 1
            else:
                if cwnd < ssthresh:
                    cwnd = min(cwnd * 2, ssthresh)
                else:
                    cwnd += 1
        return trace

    traces = {}
    for label, reno in (("Reno ", True), ("Tahoe", False)):
        tr = simulate({8, 14}, reno=reno)
        traces[label.strip()] = tr
        print(label, " ".join(f"{w:2d}" for w in tr), f"| segments sent {sum(tr)}")

    extra = sum(traces["Reno"]) - sum(traces["Tahoe"])
    print(f"Extra segments delivered by TCP Reno over Tahoe: {extra} segments\n")


