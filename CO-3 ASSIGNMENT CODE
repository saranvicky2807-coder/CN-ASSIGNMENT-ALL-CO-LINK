def run_q4_dns_resolution():
    print("=" * 70)
    print("Q4: ITERATIVE DNS RESOLUTION WITH TTL CACHE")
    print("=" * 70)

    SERVERS = {
        "root": {"in.": "tld-in", "com.": "tld-com"},
        "tld-in": {"ac.in.": "ns-ac"},
        "tld-com": {"example.com.": "ns-example"},
        "ns-ac": {"simats.ac.in.": "ns-simats"},
        "ns-simats": {"results.simats.ac.in.": "10.20.30.40"},
        "ns-example": {"www.example.com.": "93.184.216.34"},
    }
    cache = {}  # maps name -> (ip, expiry_timestamp)

    def resolve(name, ttl=300):
        now = time.time()
        if name in cache:
            ip, expiry = cache[name]
            if now < expiry:
                return ip, 0
            else:
                del cache[name]

        server, queries = "root", 0
        while True:
            queries += 1
            matches = [k for k in SERVERS[server] if name.endswith(k)]
            longest_key = max(matches, key=len)
            target = SERVERS[server][longest_key]
            if any(ch.isdigit() for ch in target):
                cache[name] = (target, now + ttl)
                return target, queries
            server = target

    for n in ("results.simats.ac.in.", "www.example.com.", "results.simats.ac.in."):
        ip, q = resolve(n, ttl=300)
        print(f"{n:<24} {ip:<15} queries sent: {q}")
    print()


def run_q5_mm1_queue():
    print("=" * 70)
    print("Q5: M/M/1 ROUTER QUEUE MODEL & LINK SIZING")
    print("=" * 70)

    def mm1(lam, mu):
        if lam >= mu:
            return None
        rho = lam / mu
        L = rho / (1 - rho)
        W = 1 / (mu - lam)
        return rho, L, W

    mu = 1000  # packets per second the link can send
    for lam in (500, 800, 900, 950, 990, 1000):
        r = mm1(lam, mu)
        if r is None:
            print(f"load {lam:4d} pkt/s: unstable, queue grows without limit")
        else:
            rho, L, W = r
            print(f"load {lam:4d} pkt/s: rho {rho:.2f}  L {L:6.1f} pkts  W {W * 1000:6.1f} ms")

    # Extra question: Capacity needed for W < 10 ms (0.01 s) at load = 1500 pkt/s
    # W = 1 / (mu - 1500) < 0.01  =>  mu - 1500 > 100  =>  mu > 1600 pkt/s
    print("\nRequired capacity for W < 10 ms at 1,500 pkt/s: > 1,600 pkt/s (e.g., 1,601 pkt/s)\n")


