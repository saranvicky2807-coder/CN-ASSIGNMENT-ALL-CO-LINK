def run_task_2_topology_reliability():
    print("=" * 72)
    print("TASK 2: TOPOLOGY LINKS, PORTS & SINGLE-LINK FAILURE SURVIVAL")
    print("=" * 72)

    def links(kind, n):
        nodes = list(range(n))
        if kind == "bus":
            return [(i, i + 1) for i in range(n - 1)]  # segments of one backbone
        if kind == "ring":
            return [(i, (i + 1) % n) for i in range(n)]
        if kind == "star":
            return [("hub", i) for i in nodes]
        if kind == "mesh":
            return list(combinations(nodes, 2))
        raise ValueError(kind)

    def connected_after_failure(edges, n, broken):
        remaining = [e for e in edges if e != broken]
        adj = {}
        for u, v in remaining:
            adj.setdefault(u, []).append(v)
            adj.setdefault(v, []).append(u)

        visited = {0}
        queue = deque([0])
        while queue:
            curr = queue.popleft()
            for nxt in adj.get(curr, []):
                if nxt not in visited:
                    visited.add(nxt)
                    queue.append(nxt)

        offices_reached = sum(1 for node in visited if isinstance(node, int) and 0 <= node < n)
        return offices_reached == n

    for n in (6, 20):
        print(f"--- Evaluating Topologies for n = {n} Offices ---")
        for kind in ("bus", "ring", "star", "mesh"):
            e = links(kind, n)
            ports = max(sum(1 for a, b in e if x in (a, b)) for x in set(sum(e, ())))
            ok = sum(connected_after_failure(e, n, b) for b in e)
            print(f"{kind:<5} links {len(e):3d}  max ports on one device {ports:2d}  "
                  f"single-link failures survived {ok}/{len(e)}")
        print()

    # Hospital 5-block cost comparison
    print("--- Hospital 5-Block Fibre Cost Comparison (Rs 60k/link + Rs 18k/port) ---")
    for name, num_links in [("Bus (N=5)", 4), ("Star (N=5)", 4),
                            ("Ring (N=5)", 5), ("Hybrid Core (N=5)", 5), ("Full Mesh (N=5)", 10)]:
        num_ports = num_links * 2
        total_cost = num_links * 60_000 + num_ports * 18_000
        print(f"{name:<18}: {num_links:2d} links, {num_ports:2d} ports -> Rs {total_cost:,}")
    print()


