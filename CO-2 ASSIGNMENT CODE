def run_q1_address_audit():
    print("=" * 70)
    print("Q1: HOSPITAL GROUP IPv4 SUBNET & HOST VALIDITY AUDIT")
    print("=" * 70)
    devices = [
        ("Admission PC", "172.16.45.200/20"),
        ("Lab Printer", "10.0.15.255/21"),
        ("X-ray Server", "192.168.4.0/23"),
        ("Clinic Router", "203.0.113.10/29"),
